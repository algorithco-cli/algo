# Account-service mode. No audience has a code default: this explicit bridge
# accepts only the two currently seeded Guard clients.
GUARD_AUTH_MODE=account
GUARD_ACCOUNT_ISSUER=https://auth.algorithco.com
GUARD_ACCOUNT_AUDIENCES=guard-web,guard-cli
GUARD_ACCOUNT_CLOCK_SKEW_SECS=5
# Read-only, Guard-product-scoped account service key. Supply the real value
# from the deployment secret manager; never commit it.
GUARD_ACCOUNT_SERVICE_KEY=
# Owner-approved default is 300, but the account contract's max-age=60 is
# stricter and therefore caps successful-response freshness at 60 seconds.
ENTITLEMENT_CACHE_MAX_TTL_SECS=300
ENTITLEMENT_REFRESH_MIN_INTERVAL_SECS=30

# Existing backend settings (supply secrets through the deployment secret
# manager; never commit them here).
ALGO_BACKEND_ADDR=127.0.0.1:8080
ALGO_SESSION_JWT_SECRET=
ALGO_POLICY_SIGNING_SEED_HEX=
