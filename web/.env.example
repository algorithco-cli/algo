# Build-time rollout switch. PR6 changes the documented default to account.
VITE_GUARD_AUTH_MODE=legacy

# Required when VITE_GUARD_AUTH_MODE=account. Redirect URI matching is exact;
# register this complete value on the guard-web public client.
VITE_ACCOUNT_ISSUER=https://auth.algorithco.com
VITE_ACCOUNT_REDIRECT_URI=http://127.0.0.1:3007/auth/callback
# TODO(owner): set the documented account billing or checkout URL. The account
# integration docs do not currently publish one, so Guard does not invent it.
VITE_ACCOUNT_BILLING_URL=

# Bare Guard backend origin. Omit during Vite development to use /api proxying.
VITE_BACKEND_URL=http://127.0.0.1:8080
