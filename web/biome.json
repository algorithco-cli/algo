{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "ignoreUnknown": true },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2 },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "noForEach": "off"
      },
      "a11y": {
        "useValidAnchor": "off",
        "useGenericFontNames": "off"
      }
    }
  },
  "overrides": [
    {
      "include": ["src/components/BranchedMenu.tsx"],
      "linter": { "rules": { "correctness": { "useExhaustiveDependencies": "off" } } }
    },
    {
      "include": ["src/components/BlurText.tsx"],
      "linter": { "rules": { "suspicious": { "noArrayIndexKey": "off" } } }
    },
    {
      "include": ["src/fonts.css"],
      "formatter": { "enabled": false },
      "linter": { "enabled": false }
    }
  ],
  "javascript": { "formatter": { "quoteStyle": "double" } }
}
