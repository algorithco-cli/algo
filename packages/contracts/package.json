{
  "name": "algocli",
  "version": "0.1.3",
  "private": false,
  "description": "algorithco guard contracts SDK (protobuf-es output from algorithco_guard.v0). Generated at build from pinned proto tag — never hand-edit.",
  "license": "GPL-3.0-only",
  "author": "algorithco guard",
  "repository": {
    "type": "git",
    "url": "https://github.com/algorithco-cli/algo"
  },
  "homepage": "https://github.com/algorithco-cli/algo/tree/main/proto#readme",
  "bugs": "https://github.com/algorithco-cli/algo/issues",
  "keywords": [
    "security",
    "protobuf",
    "contracts",
    "guardrails"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('src/gen',{recursive:true,force:true});require('fs').rmSync('gen',{recursive:true,force:true})\"",
    "generate": "node scripts/generate-pinned.mjs",
    "generate:root": "buf generate proto --template proto/buf.gen.yaml",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && npm run generate && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "lint": "npm run generate && tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --input-type=module -e \"import('./dist/index.js').then(m=>{if(!m.DecisionSchema)process.exit(1)})\"",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.2.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
