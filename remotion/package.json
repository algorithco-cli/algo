{
  "name": "algorithco-guard-ad",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion website ad for algorithco guard",
  "scripts": {
    "tokens": "node scripts/generate-theme.mjs",
    "prepare": "npm run tokens",
    "predev": "npm run tokens",
    "dev": "remotion studio",
    "prebuild": "npm run tokens",
    "build": "remotion render GuardAd out/guard-ad.mp4 --codec=h264 --crf=16",
    "prebuild:15": "npm run tokens",
    "build:15": "remotion render Guard15 out/algorithco-guard-15s.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p",
    "prestill:15": "npm run tokens",
    "still:15": "remotion still Guard15 out/algorithco-guard-15s-cover.png --frame=220",
    "prebuild:webm": "npm run tokens",
    "build:webm": "remotion render GuardAd out/guard-ad.webm --codec=vp9",
    "prestill": "npm run tokens",
    "still": "remotion still GuardAd out/thumbnail.png --frame=60",
    "prebuild:x": "npm run tokens",
    "build:x": "remotion render GuardX out/guard-x.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p",
    "prestill:x": "npm run tokens",
    "still:x": "remotion still GuardX out/guard-x-cover.png --frame=95",
    "pretypecheck": "npm run tokens",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.529",
    "@remotion/fonts": "4.0.529",
    "@remotion/transitions": "4.0.529",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
