{
  "name": "algorithco-guard-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "algorithco guard — team dashboard SPA (React+Vite static, no Node runtime in prod)",
  "license": "UNLICENSED",
  "author": "algorithco guard",
  "repository": {
    "type": "git",
    "url": "https://github.com/algorithcoguard/algorithco-guard"
  },
  "homepage": "https://github.com/algorithcoguard/algorithco-guard#readme",
  "bugs": "https://github.com/algorithcoguard/algorithco-guard/issues",
  "keywords": [
    "security",
    "guardrails",
    "dashboard"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "lint": "tsc --noEmit && biome check src vite.config.ts vitest.config.ts",
    "lint:fix": "biome check --write src vite.config.ts vitest.config.ts",
    "format": "biome format --write src vite.config.ts vitest.config.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@tanstack/react-router": "^1.58.0",
    "@tanstack/react-query": "^5.60.0",
    "@tanstack/react-table": "^8.20.5",
    "uplot": "^1.6.31",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.4",
    "class-variance-authority": "^0.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "vitest": "^5.0.1",
    "typescript": "^7.0.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/node": "^22.12.0",
    "vite": "^8.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^3.4.10",
    "postcss": "^8.4.40",
    "autoprefixer": "^10.4.20"
  }
}
