# Copy to .env (git-ignored) and export, or export directly. NEVER commit a filled copy.
#   Windows (PowerShell):  $env:ALGO_JEV_API_KEY = "..."
#   macOS/Linux (bash):    export ALGO_JEV_API_KEY="..."
ALGO_JEV_API_KEY=
# Region label recorded in reports (vendor regions VERIFY-OPEN; until confirmed this
# labels the vantage network, e.g. "vantage-eu-central" — NOT a vendor region).
ALGO_JEV_REGION=
# Model alias or pinned versioned id (pin versioned id, e.g. jev-1.13.0, for runs
# whose thresholds were tuned against it; see docs/verify/jev-api.md §1).
ALGO_JEV_MODEL=jev-latest
