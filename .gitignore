# Python (eval/)
__pycache__/
*.pyc
*.pyo
.mypy_cache/
.ruff_cache/
.pytest_cache/
.venv/
venv/
eval/reports/*
!eval/reports/README.md
!eval/reports/jev-v0.1-TEMPLATE.md
!eval/reports/jev-v0.1-TEMPLATE.json
!eval/reports/.gitkeep

# Rust (core/, agent/, backend/ — Phase 1+)
target/
Cargo.lock

# Node (dashboard/, web/ — Phase 2+)
node_modules/
dist/
build/

# Secrets / local env — never commit
.env
*.pem
*.key

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Proto codegen (buf generate output — build artifact, never commit)
# out paths in proto/buf.gen.yaml are cwd-relative: generating from the repo
# root (as CI does) writes gen/, from proto/ writes proto/gen/. Ignore both
# so generated output never dirties the tree.
gen/
proto/gen/

# Proptest regressions (generated by cargo test, not for commit)
**/proptest-regressions/
